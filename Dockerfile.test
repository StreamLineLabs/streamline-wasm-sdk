# WASM SDK Test Container
#
# Builds and runs the WASM SDK test suite in a containerized environment.
# Usage:
#   docker build -f Dockerfile.test -t streamline-wasm-sdk-test .
#   docker run --rm streamline-wasm-sdk-test
#
# For integration tests with a live Streamline server:
#   docker compose -f docker-compose.test.yml up -d
#   docker build -f Dockerfile.test -t streamline-wasm-sdk-test .
#   docker run --rm --network host streamline-wasm-sdk-test cargo test

FROM rust:1.80-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    curl \
    chromium \
    && rm -rf /var/lib/apt/lists/*

# Install wasm-pack and wasm32 target
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh
RUN rustup target add wasm32-unknown-unknown

# Install chromedriver for headless browser tests
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_SKIP_DOWNLOAD=true

WORKDIR /app

# Cache dependencies
COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/lib.rs && \
    cargo build --target wasm32-unknown-unknown 2>/dev/null || true && \
    rm -rf src

# Copy source
COPY . .

# Run unit tests (native)
RUN cargo test --lib

# Build WASM module
RUN cargo build --target wasm32-unknown-unknown --release

# Run wasm-pack tests (headless Chrome)
# Note: browser tests require --headless --chrome
CMD ["wasm-pack", "test", "--headless", "--chrome"]
